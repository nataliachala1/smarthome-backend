NODE_ENV=development
PORT=3000

# Empty: ignore forwarded IP headers. Behind a proxy, list ONLY its actual IP/CIDR.
# The trusted proxy must sanitize X-Forwarded-For/Host/Proto. See docs/HU09_RATE_LIMITING.md.
TRUSTED_PROXY_CIDRS=

# The database baseline creates these NOLOGIN roles. Provision separate LOGIN
# users and grant each membership outside Liquibase; do not use the owner role.
# Both runtime connections target the same `smarthome` database with least privilege.
DATABASE_URL=postgresql://smarthome_app_login:CHANGE_ME@localhost:5432/smarthome
DATABASE_IOT_URL=postgresql://smarthome_ingest_login:CHANGE_ME@localhost:5432/smarthome

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=smarthome-backend-local
MQTT_STATUS_CLIENT_ID=smarthome-backend-status-local
MQTT_USERNAME=
MQTT_PASSWORD=
# Empty namespace preserves legacy LOCAL topics. Production requires a namespace
# such as smarthome/production/v1, mqtts://, and service credentials.
MQTT_TOPIC_NAMESPACE=
# Optional PEM CA bundle for mqtts://; empty uses Node's trusted CAs.
MQTT_TLS_CA_FILE=
# Topic filters are derived. Remove old overrides before enabling a namespace.
# See docs/HU10_MQTT_TLS_NAMESPACE.md. These credentials are for the backend;
# cloud device bootstrap requires individual credentials (HU11/HU12).

SWAGGER_ENABLED=true
LOG_LEVEL=info

DEVICE_OFFLINE_TIMEOUT_SECONDS=60
DEVICE_OFFLINE_WATCH_INTERVAL_SECONDS=30
LOCAL_DEVICE_DISCOVERY_ENABLED=false
