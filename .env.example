NODE_ENV=development
PORT=3000

# Empty: ignore forwarded IP headers. Behind a proxy, list ONLY its actual IP/CIDR.
# The trusted proxy must sanitize X-Forwarded-For/Host/Proto. See docs/HU09_RATE_LIMITING.md.
TRUSTED_PROXY_CIDRS=

# The database baseline creates these NOLOGIN roles. Provision separate LOGIN
# users and grant each membership outside Liquibase; do not use the owner role.
# Both runtime connections target the same `smarthome` database with least privilege.
DATABASE_URL=postgresql://smarthome_app_login:CHANGE_ME@localhost:5432/smarthome
DATABASE_IOT_URL=postgresql://smarthome_ingest_login:CHANGE_ME@localhost:5432/smarthome

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# Local Shelly LAN discovery/RPC is opt-in and forbidden in Production.
SHELLY_LOCAL_ENABLED=false

MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_ENABLED=true
MQTT_BROKER_PROVIDER=mosquitto
# VPS Development pairing requires a separate opt-in and validated TLS/DEV configuration.
SHELLY_MQTT_VPS_DEV_PAIRING_ENABLED=false
# Enables the authenticated RPC challenge worker in VPS DEV; requires the
# dedicated MQTT auth PostgreSQL URLs and all VPS pairing/TLS checks above.
SHELLY_MQTT_VPS_DEV_AUTH_WORKER_ENABLED=false
# Enables fenced cleanup for unbound pair operations and SQL011 identities.
# Keep false until SQL032 and the broker reconciliation checks are validated in DEV.
SHELLY_MQTT_VPS_DEV_REVOCATION_WORKER_ENABLED=false
# Dedicated login in the smarthome_mqtt_revoke group; PostgreSQL TLS is mandatory on VPS.
MQTT_REVOCATION_DATABASE_URL=
# Production MQTT pairing remains disabled unless every production-only
# broker, PostgreSQL, migration, revocation, TLS, and encryption precondition passes.
SHELLY_MQTT_PRODUCTION_PAIRING_ENABLED=false
SHELLY_MQTT_PRODUCTION_REVOCATION_WORKER_ENABLED=false
SHELLY_MQTT_PRODUCTION_AUTH_WORKER_ENABLED=false
# Private TLS endpoint for DynSec admin; must be the same listener as MQTT_BROKER_URL.
MQTT_DYNSEC_ADMIN_URL=
MQTT_DYNSEC_ADMIN_USERNAME=
MQTT_DYNSEC_ADMIN_PASSWORD=
MQTT_DYNSEC_ADMIN_CA_FILE=
# Public TLS endpoint for devices, backed by the same Mosquitto instance but
# separated from the private backend/admin endpoint; include a Shelly-trusted root.
SHELLY_MQTT_PRODUCTION_DEVICE_BROKER_URL=
SHELLY_MQTT_PRODUCTION_DEVICE_CA_FILE=
# Production-only LOGINs, each in the same production DB and with one reviewed NOLOGIN role membership.
MQTT_RESERVER_DATABASE_URL=
MQTT_LEASE_DATABASE_URL=
MQTT_CONFIRMER_DATABASE_URL=
MQTT_SECRET_DATABASE_URL=
MQTT_RPC_DATABASE_URL=
MQTT_AUTH_DATABASE_URL=
MQTT_PREPARATION_AES_KEY_B64URL=
MQTT_PREPARATION_AES_KEY_ID=
# Public broker configuration sent to the Shelly; never use the backend broker CA here.
SHELLY_MQTT_VPS_DEV_DEVICE_BROKER_URL=mqtts://mqtt-dev.example.com:443
SHELLY_MQTT_VPS_DEV_DEVICE_CA_FILE=
MQTT_CLIENT_ID=smarthome-backend-local
MQTT_STATUS_CLIENT_ID=smarthome-backend-status-local
MQTT_USERNAME=
MQTT_PASSWORD=
# Empty namespace preserves legacy LOCAL topics. Production pairing requires
# smarthome/prod/v1, mqtts://, and individual identities for new devices.
MQTT_TOPIC_NAMESPACE=
# Optional PEM CA bundle for mqtts://; empty uses Node's trusted CAs.
MQTT_TLS_CA_FILE=
# Topic filters are derived. Remove old overrides before enabling a namespace.
# See docs/HU10_MQTT_TLS_NAMESPACE.md. These credentials are for the backend;
# cloud device bootstrap requires individual credentials (HU11/HU12).

SWAGGER_ENABLED=true
# Account emails (activation, password reset, reactivation).
# Local/demo: EMAIL_ENABLED=true with Mailpit (SMTP_HOST=localhost, SMTP_PORT=1025).
# Without SMTP_HOST the Gmail service is used with SMTP_USER and SMTP_APP_PASSWORD.
# With EMAIL_ENABLED=false registration is rejected and nothing is stored.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=SmartHome <no-reply@smarthome.local>
SMTP_USER=
SMTP_APP_PASSWORD=
LOG_LEVEL=info

DEVICE_OFFLINE_TIMEOUT_SECONDS=60
DEVICE_OFFLINE_WATCH_INTERVAL_SECONDS=30
LOCAL_DEVICE_DISCOVERY_ENABLED=false

# Separate metrics worker (enable only with the dedicated smarthome_worker LOGIN).
CONSUMPTION_METRICS_WORKER_ENABLED=false
DATABASE_METRICS_URL=
